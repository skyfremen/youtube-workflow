{
  "schema_version": 2,
  "contract": "gitless_planner_materialization",
  "materialization_mode": "explicit_file_list",
  "git_required": false,
  "git_executable_required": false,
  "checkout_required": false,
  "git_metadata_required": false,
  "repository_archive_required": false,
  "directory_enumeration_required": false,
  "repository_identity": {
    "field": "rules_source_sha",
    "source": "GitHub API/connector current-main commit SHA"
  },
  "pythonpath_root": "youtube-shorts-bot",
  "required_python_files": [
    "youtube-shorts-bot/common/__init__.py",
    "youtube-shorts-bot/common/workflow_common.py",
    "youtube-shorts-bot/media/__init__.py",
    "youtube-shorts-bot/media/background_policy.py",
    "youtube-shorts-bot/media/validate_media_library.py",
    "youtube-shorts-bot/media/background_selector_base.py",
    "youtube-shorts-bot/media/media_readiness.py",
    "youtube-shorts-bot/planning/__init__.py",
    "youtube-shorts-bot/planning/planning_config.py",
    "youtube-shorts-bot/planning/ranked_promotion.py",
    "youtube-shorts-bot/planning/planner_contract.py",
    "youtube-shorts-bot/planning/adhoc_precommit.py",
    "youtube-shorts-bot/planning/daily_precommit.py",
    "youtube-shorts-bot/publishing/__init__.py",
    "youtube-shorts-bot/publishing/upload.py",
    "youtube-shorts-bot/validation/__init__.py",
    "youtube-shorts-bot/validation/semantic.py",
    "youtube-shorts-bot/validation/schema_v4.py",
    "youtube-shorts-bot/validation/validate_content.py"
  ],
  "required_data_files": [
    "youtube-shorts-bot/media-library/backgrounds.json"
  ],
  "source_rule": "Fetch every required_python_files and required_data_files path directly from the exact rules_source_sha using the GitHub API/connector and write it as an ordinary UTF-8 file preserving repository-relative paths. Do not enumerate or download whole source directories. No repository archive, checkout, .git directory or Git executable is required.",
  "planner_state_placeholders": {
    "rule": "For the explicit existence/uniqueness checks below, materialize zero-byte placeholder files for matching canonical repository paths. Their contents are not read by those checks.",
    "adhoc_scheduled_uniqueness": [
      "youtube-shorts-bot/content/requests/wd-<YYYYMMDD>T010000-adhoc-*.json"
    ],
    "daily_uniqueness": [
      "youtube-shorts-bot/content/planning/<plan_date>.json",
      "youtube-shorts-bot/content/planning-pools/daily/<plan_date>/<pool_id>.json"
    ]
  },
  "entrypoints": [
    "python -m planning.planner_contract",
    "python -m media.media_readiness audit --allow-not-ready",
    "python -m planning.adhoc_precommit --pool <pool> --rules-source-sha <sha>",
    "python -m planning.daily_precommit --pool <pool> --rules-source-sha <sha>"
  ],
  "forbidden_bootstrap_requirements": [
    ".git",
    "git clone",
    "git rev-parse",
    "authenticated checkout",
    "repository archive",
    "whole-repository download",
    "whole-directory source materialization",
    "synthetic HEAD",
    "snapshot bootstrap",
    "GitHub Actions planner execution"
  ]
}
