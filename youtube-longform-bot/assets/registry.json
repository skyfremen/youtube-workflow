{
  "version": 6,
  "design_system": "wacky_insights_v2",
  "visual_policy": {
    "style": "editorial_scene_led_2d_vector_explainer",
    "forbid_powerpoint_layouts": true,
    "environment_first": true,
    "max_fullscreen_infographic_ratio": 0.15,
    "prefer_infographic_overlays": true,
    "prefer_object_labels": true,
    "max_caption_words": 7,
    "max_static_gap_seconds": 1.5,
    "distinct_scene_transitions": true,
    "same_environment_new_scene_minimum_differences": 2,
    "notes": "Scenes should feel like continuous animated storytelling. A true scene cut should introduce a meaningfully different shot. Near-identical background/framing changes belong inside one scene as camera moves, inserts, reactions or state changes. Avoid title-plus-card layouts, presentation grids and blink-like cuts."
