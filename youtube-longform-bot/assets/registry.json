{
  "version": 6,
  "design_system": "wacky_insights_v2",
  "visual_policy": {
    "style": "editorial_scene_led_2d_vector_explainer",
    "forbid_powerpoint_layouts": true,
    "environment_first": true,
    "max_fullscreen_infographic_ratio": 0.15,
    "prefer_infographic_overlays": true,
    "prefer_object_labels": true,
    "max_caption_words": 7,
    "max_static_gap_seconds": 1.5,
    "distinct_scene_transitions": true,
    "same_environment_new_scene_minimum_differences": 2,
    "notes": "Scenes should feel like continuous animated storytelling. A true scene cut should introduce a meaningfully different shot. Near-identical background/framing changes belong inside one scene as camera moves, inserts, reactions or state changes. Avoid title-plus-card layouts, presentation grids and blink-like cuts."
  },
  "characters": {},
  "environments": {},
  "props": {},
  "infographics": {},
  "motions": [
    "fade_in",
    "slide_in_left",
    "slow_zoom",
    "punch_zoom",
    "pan_left",
    "pan_right",
    "pop",
    "float",
    "open_prop",
    "highlight",
    "walk",
    "point",
    "track",
    "split_reveal",
    "reframe",
    "reaction_closeup",
    "insert_cut",
    "match_action",
    "object_wipe",
    "state_change",
    "transform",
    "enter_exit",
    "cause_effect_chain"
  ],
  "scene_types": [
    "environment_character",
    "environment_overlay",
    "behavior_comparison",
    "character_closeup",
    "environment_summary"
  ],
  "shot_framings": ["wide", "medium", "closeup", "insert", "over_shoulder", "reaction", "split_behavior"],
  "camera_angles": ["front", "three_quarter", "side", "over_shoulder", "detail"],
  "transition_types": ["cut_to_distinct_environment", "match_action", "push_in", "insert_cut", "reaction_cut", "reframe", "object_wipe", "continuation"]
}
